{
  "name": "universal-integration-engine",
  "version": "1.0.0",
  "description": "Reusable multi-tenant integration platform with secure credential management, OAuth2 token coordination, and reliable background processing.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:ci",
    "test:ci": "tsx tests/security/credential-encryption.ts && tsx tests/connectors/auth/api-key.strategy.ts && tsx tests/connectors/auth/auth.executor.ts && tsx tests/connectors/auth/auth.registry.ts && tsx tests/connectors/auth/basic.strategy.ts && tsx tests/connectors/auth/bearer.strategy.ts && tsx tests/connectors/auth/create-application-authentication.ts && tsx tests/connectors/auth/none.strategy.ts && tsx tests/connectors/auth/oauth2-token.client.ts && tsx tests/connectors/auth/oauth2.config.ts && tsx tests/connectors/auth/oauth2.strategy.ts && tsx tests/connectors/auth/static-oauth2-provider-config-resolver.ts && tsx tests/connectors/authenticated-api-client.ts && tsx tests/connectors/api-client-retry.ts && tsx tests/core/webhook-idempotency-scope.ts && tsx tests/security/bigcommerce-webhook-signature.ts && tsx tests/security/webhook-body-limit.ts && tsx tests/security/webhook-route-body-limit.ts",
    "test:queue": "tsx tests/test-queue.ts",
    "dev:worker": "tsx watch src/infra/queues/worker.ts",
    "start:worker": "node dist/infra/queues/worker.js",
    "build:worker": "tsc --project tsconfig.worker.json",
    "test:stress": "tsx tests/stress/queue-load.ts",
    "test:stress:bullmq": "tsx tests/stress/bullmq-load.ts",
    "test:stress:webhook": "tsx tests/stress/webhook-database.ts",
    "test:stress:idempotency": "tsx tests/stress/idempotency-database.ts",
    "dev:recovery": "tsx watch src/infra/queues/recovery-worker.ts",
    "dev:outbox": "tsx watch src/infra/queues/outbox-worker.ts",
    "test:stress:recovery": "tsx tests/stress/recovery-dispatcher.ts",
    "test:stress:outbox": "tsx tests/stress/outbox-dispatcher.ts",
    "test:stress:outbox-retry": "tsx tests/stress/outbox-retry.ts",
    "test:stress:recovery:e2e": "tsx tests/stress/recovery-e2e.ts",
    "test:stress:recovery:concurrency": "tsx tests/stress/recovery-concurrency.ts",
    "test:stress:webhook:concurrency": "tsx tests/stress/concurrent-webhook-processing.ts",
    "test:stress:stale-worker": "tsx tests/stress/stale-worker-completion.ts",
    "test:stress:outbox:stale-lock": "tsx tests/stress/outbox-stale-lock.ts",
    "test:stress:outbox:crash": "tsx tests/stress/outbox-crash-after-queue-add.ts",
    "test:stress:outbox:exhausted": "tsx tests/stress/outbox-exhausted-stale-lock.ts",
    "test:stress:tenant-isolation": "tsx tests/stress/tenant-isolation.ts",
    "test:connectors:retry": "tsx tests/connectors/api-client-retry.ts",
    "test:connectors:bigcommerce": "tsx tests/connectors/bigcommerce-tenant-isolation.ts",
    "test:security:credentials": "tsx tests/security/credential-encryption.ts",
    "test:stress:recovery:provider-agnostic": "tsx tests/stress/recovery-provider-agnostic.ts",
    "test:stress:recovery:rollback": "tsx tests/stress/recovery-transaction-rollback.ts",
    "test:stress:recovery:fairness": "tsx tests/stress/recovery-batch-fairness.ts",
    "test:stress:recovery:multiprocess": "tsx tests/stress/recovery-multiprocess-concurrency.ts",
    "test:stress:recovery:multiprocess:failure": "tsx tests/stress/recovery-multiprocess-failure.ts",
    "test:security:webhook-body": "tsx tests/security/webhook-body-limit.ts",
    "test:security:webhook-route": "tsx tests/security/webhook-route-body-limit.ts",
    "test:security:webhook-signature": "tsx tests/security/bigcommerce-webhook-signature.ts",
    "test:stress:outbox:stale-redelivery": "tsx tests/stress/outbox-stale-redelivery.ts",
    "test:stress:webhook:identity": "tsx tests/stress/webhook-identity-regression.ts"
  },
  "keywords": [
    "typescript",
    "nodejs",
    "integration-platform",
    "multi-tenant",
    "oauth2",
    "bullmq",
    "prisma",
    "postgresql",
    "distributed-locking",
    "idempotency"
  ],
  "author": "Cris Vincent R. Castro",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "axios": "^1.21.0",
    "bullmq": "^6.5.4",
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
